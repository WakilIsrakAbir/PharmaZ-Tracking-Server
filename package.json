{
  "name": "pharmaz-tracker-server",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaZ247 Tracker API",
  "type": "module",
  "main": "api/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "predev": "kill-port 4000",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db": "node --env-file-if-exists=.env scripts/local-db.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test:api": "node scripts/test-api.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "js,json,env",
    "delay": 300
  }
}
