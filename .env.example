# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored. Never commit real secrets.

# Port the API listens on
PORT=4000

# MongoDB connection string. Keep the database name (/pharmaz-tracker) in it.
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/pharmaz-tracker?retryWrites=true&w=majority&appName=pharmaz-tracker-api
#   Local only:     mongodb://127.0.0.1:27017/pharmaz-tracker   (start it with `npm run db`)
# A password with special characters (@ : / ? # %) must be URL-encoded.
MONGODB_URI=

# Secret used to sign sign-in sessions: a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a sign-in lasts, in days
SESSION_DAYS=7

# Address of the web app (allowed to call the API from the browser)
CLIENT_ORIGIN=http://localhost:3000

# First admin account, used once by `npm run seed:admin` (safe to run twice).
# The password is stored in the database as a bcrypt hash; empty it here after seeding.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (optional). When an admin assigns teammates to a form, each one gets an email with the form.
# Leave these empty and the API simply sends no email.
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
#     SMTP_PASS=an App Password (Google Account → Security → 2-Step Verification → App passwords),
#     EMAIL_FROM="PharmaZ247 Tracker <your address>"
#   Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER and SMTP_PASS from Brevo → SMTP & API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Address of the web app, for the "Open in the tracker" link in emails. Defaults to CLIENT_ORIGIN.
APP_URL=
